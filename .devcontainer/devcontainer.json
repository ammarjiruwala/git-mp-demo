{
  "name": "Git MP demo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  // Once, when the Codespace is created: terminal hook, Git settings, practice repos.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Every time VS Code connects: install the Git Map extension.
  "postAttachCommand": "bash .devcontainer/install-extension.sh",

  "customizations": {
    "vscode": {
      "settings": {
        "workbench.editorAssociations": { "**/lessons/*.md": "vscode.markdown.preview.editor" },
        "files.exclude": { "**/.course-files": true, "**/.devcontainer": true, "**/git-map": true },
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "workbench.editor.enablePreview": false,
        "workbench.editor.enablePreviewFromQuickOpen": false,
        "terminal.integrated.shellIntegration.enabled": true,
        "git.autoRepositoryDetection": "subFolders",
        "git.openRepositoryInParentFolders": "never"
      }
    }
  }
}
