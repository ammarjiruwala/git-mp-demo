#!/usr/bin/env bash
# Builds everything in workspace/ for the MP:
#   hq/                     folders to explore in Chapter 0
#   warehouse.git           the team's "GitHub" (you clone it in Chapter 1)
#   playground/             a safe practice repo (./reset puts it back)
#   practice-warehouse.git  the playground's own "GitHub"
# Running it again ERASES your mission work and starts the MP over.
set -e
cd "$(dirname "$0")"
ROOT=$(pwd)
W="$ROOT/workspace"

if [ -d "$W/mission" ] && [ "$1" != "--yes" ]; then
  read -r -p "This erases your mission repo and starts the MP over. Type yes to continue: " ok
  [ "$ok" = "yes" ] || { echo "Nothing changed."; exit 1; }
fi

source "$ROOT/course/lib.sh"
rm -rf "$W"
mkdir -p "$W"
build_hq "$W/hq"
build_story_warehouse "$W/warehouse.git" "$ROOT"
build_playground "$W"
[ -f "$ROOT/answers.txt" ] || cp "$ROOT/course/answers-template.txt" "$ROOT/answers.txt"

echo "Ready. Open lessons/00-terminal.md to begin."
